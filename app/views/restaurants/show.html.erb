<h1>You should see a beautiful restaurant below !!!</h1>

<p><%= @restaurant.name %></p>

<p><%= @restaurant.address %></p>

<p><%= @restaurant.phone_number %></p>

<p><%= @restaurant.category %></p>

<p><%= link_to 'homepage', restaurants_path %></p>

<p><%= link_to 'add a review', new_restaurant_review_path(@restaurant) %></p>

<p><strong>Reviews</strong></p>
<ul class="list-group">
  <% @restaurant.reviews.each do |review| %>
    <li class="list-group-item"><%= review.content %></li>
  <% end %>
</ul>
<br>
